# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather
ALLOWED_CHAT_IDS=123456789          # your Telegram user id(s), comma separated

# MT5 (use a DEMO account first!)
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_LOGIN=12345678
MT5_PASSWORD=your_password
MT5_SERVER=YourBroker-Demo

# Risk
RISK_PERCENT=1.0            # % of balance risked per signal (split across TPs)
MAX_LOT=1.0
MAX_SPREAD_POINTS=50        # skip if spread wider than this
ENTRY_TOLERANCE_POINTS=300  # how far price may be past entry and still enter at market (gold: 300 pts = $3)
MAX_OPEN_SIGNALS=3
MAGIC=777001
SYMBOL_SUFFIX=              # e.g. "m" or ".pro" if broker uses XAUUSDm
MOVE_SL_TO_BE_AFTER_TP1=true
PENDING_EXPIRY_MIN=120
LOCK_TP1_AFTER_TP2=true     # after TP2 hits, move last leg's SL to TP1

# Platform: auto = Windows uses MetaTrader5, Linux uses mt5linux (MT5 under Wine)
#           paper = simulator, no broker (safe testing; type "price XAUUSD 4500" in Telegram)
MT5_MODE=auto
MT5LINUX_HOST=localhost
MT5LINUX_PORT=18812
STATE_FILE=state.json
DAILY_LOSS_LIMIT_PCT=5      # block new trades once today's equity loss reaches this %
DUPLICATE_WINDOW_MIN=30     # same signal again within N minutes is ignored
